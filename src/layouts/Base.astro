---
import '../styles/global.css';
import { siteConfig } from '../../site.config';
import { useTranslations, localePath, LOCALES, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Overrides the catalogue title. Used by the not-found page. */
  title?: string;
  /** Omit the page from search indexes. */
  noindex?: boolean;
}

const { locale, title, noindex = false } = Astro.props;
const t = useTranslations(locale);

const pageTitle = title ?? t('meta.title');
const canonical = new URL(localePath(locale), siteConfig.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {/* Every locale is a real route, so each declares the others. */}
    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(localePath(l), siteConfig.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL('/', siteConfig.site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Self-hosted, so no third-party font request is on the critical path.
      Only the two latin faces are preloaded: the Vietnamese subsets are
      fetched by unicode-range only when a page actually needs them.
    */}
    <link
      rel="preload"
      href="/fonts/oswald-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="theme-color" content="#12170f" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    {/*
      Cookieless, so no consent banner is required (REQ-UBI-08). Rendered only
      once a token exists, and `defer` plus the absence of any dependent code
      means a blocked or failed beacon changes nothing (REQ-ERR-04).

      No `integrity` attribute: Cloudflare publishes this beacon at a stable
      unversioned URL and rolls its contents, so a pinned hash would silently
      disable analytics at their next release rather than protect anything.
      The residual risk is a compromised Cloudflare CDN, and it is bounded
      here because this site holds no credentials, no forms and no payment
      path, which GitHub Pages' terms forbid it from holding in any case.
    */}
    {
      siteConfig.analyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${siteConfig.analyticsToken}"}`}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">{t('skip.toContent')}</a>
    <slot />
  </body>
</html>
