---
import '../styles/global.css';
import { siteConfig } from '../../site.config';
import { useTranslations, localePath, LOCALES, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** The route below the locale prefix, e.g. 'privacy/'. Empty for home. */
  path?: string;
  /** A unique title for this page. Falls back to the home title. */
  title?: string;
  /** A unique description for this page. */
  description?: string;
  /** Omit the page from search indexes. */
  noindex?: boolean;
  /** Emit hreflang alternates. Off for the single bilingual 404. */
  alternates?: boolean;
}

const {
  locale,
  path = '',
  title,
  description,
  noindex = false,
  alternates = true,
} = Astro.props;
const t = useTranslations(locale);

const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const url = (l: Locale) => new URL(localePath(l) + path, siteConfig.site).href;
const canonical = url(locale);
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {
      alternates && (
        <>
          {LOCALES.map((l) => (
            <link rel="alternate" hreflang={l} href={url(l)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={url('en')} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TrekLink" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      The saved theme is applied before first paint so a light-theme visitor
      never sees a dark flash. Dark is the brand default. Inline and tiny on
      purpose; everything else is an island.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var saved = localStorage.getItem('treklink.theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>

    <link
      rel="preload"
      href="/fonts/oswald-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="theme-color" content="#0f140c" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    {
      siteConfig.analyticsToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${siteConfig.analyticsToken}"}`}
        />
      )
    }
  </head>

  <body>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t('skip.toContent')}</a>
    <slot />
    <a class="to-top" href="#top" data-to-top aria-label={t('top.label')}>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        <path d="M10 15V5M5 10l5-5 5 5"></path>
      </svg>
    </a>

    {/*
      Every island upgrades markup that already works, and each mounts on its
      own so one failure cannot take the rest down (REQ-ERR-05).
    */}
    <script>
      import { mountSystemLink } from '../islands/system-link';
      import { mountCarousel } from '../islands/carousel';
      import { mountScrollspy } from '../islands/scrollspy';
      import { mountHeaderScroll } from '../islands/header-scroll';
      import { mountReveal } from '../islands/reveal';
      import { mountMeshMap } from '../islands/mesh-map';
      import {
        mountThemeToggle,
        mountScrollProgress,
        mountBackToTop,
        mountUtmPassThrough,
      } from '../islands/chrome';
      import {
        mountLanguageSwitcher,
        mountMobileNav,
      } from '../islands/language-switcher';

      for (const mount of [
        mountThemeToggle,
        mountUtmPassThrough,
        mountReveal,
        mountHeaderScroll,
        mountScrollProgress,
        mountBackToTop,
        mountSystemLink,
        mountCarousel,
        mountMeshMap,
        mountScrollspy,
        mountLanguageSwitcher,
        mountMobileNav,
      ]) {
        try {
          mount();
        } catch (error) {
          console.error('[island] failed to mount', error);
        }
      }
    </script>
  </body>
</html>
