---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * Question 12 asked for an R&D section that reads generally and
 * professionally. REQ-UBI-07 forbids team names. Nothing here carries a
 * research question identifier or a metric, because none has been measured
 * yet and a fabricated number in front of a review panel is worse than no
 * number at all.
 */
const items = ['a', 'b', 'c', 'd'] as const;
const cards = items.map((k) => ({
  title: t(`research.${k}.title` as 'research.a.title'),
  body: t(`research.${k}.body` as 'research.a.body'),
}));
---

<section class="section grain" id="research">
  <div class="shell above">
    <header class="section-head">
      <p class="eyebrow">{t('research.eyebrow')}</p>
      <h2>{t('research.heading')}</h2>
      <p class="lede">{t('research.lede')}</p>
    </header>

    {/*
      Fyntic's split grid: cards flanking a centre column. Here the centre
      holds a route profile rather than a sales call to action, because this
      page has exactly one destination and it lives in the header.
    */}
    <div class="split">
      <div class="column">
        {
          cards.slice(0, 2).map((c, i) => (
            <article class="glass card">
              <span class="index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))
        }
      </div>

      <div class="spine" aria-hidden="true">
        <svg viewBox="0 0 120 420" preserveAspectRatio="none" role="presentation">
          <path
            d="M60 0 L60 90 L18 150 L92 232 L34 300 L60 356 L60 420"
            fill="none"
            stroke="var(--moss-deep)"
            stroke-width="2"
            stroke-linejoin="round"
          ></path>
          <circle cx="60" cy="90" r="5" fill="var(--brass)"></circle>
          <circle cx="92" cy="232" r="5" fill="var(--brass)"></circle>
          <circle cx="60" cy="356" r="5" fill="var(--brass)"></circle>
        </svg>
      </div>

      <div class="column">
        {
          cards.slice(2).map((c, i) => (
            <article class="glass card">
              <span class="index" aria-hidden="true">
                {String(i + 3).padStart(2, '0')}
              </span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .section-head {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }
  h2 {
    font-size: var(--step-3);
  }

  .split {
    margin-top: clamp(2.2rem, 1.6rem + 2.6vw, 3.4rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(1rem, 0.5rem + 2vw, 2.4rem);
    align-items: stretch;
  }

  .column {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .card {
    padding: clamp(1.3rem, 1.1rem + 1vw, 1.8rem);
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }
  .index {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--brass);
    line-height: 1;
  }
  .card h3 {
    font-size: var(--step-1);
    color: var(--ink);
  }
  .card p {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.65;
  }

  /* A route profile, not an ornament: the four cards are stages of one path
     from the device to the responder. */
  .spine {
    width: 4.5rem;
    display: grid;
    place-items: stretch;
  }
  .spine svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 899px) {
    .split {
      grid-template-columns: 1fr;
    }
    .spine {
      display: none;
    }
  }
</style>
