---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Problem from './Problem.astro';
import NodeLines from './NodeLines.astro';
import HowItWorks from './HowItWorks.astro';
import Meshtastic from './Meshtastic.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n';

/*
 * The whole document, once. Each locale route is a thin wrapper that passes a
 * locale, so the two routes cannot drift in structure and a new section is
 * added in exactly one place.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale}>
  <Header locale={locale} />
  <main id="main" tabindex="-1">
    <Hero locale={locale} />
    <Problem locale={locale} />
    <HowItWorks locale={locale} />
    <NodeLines locale={locale} />
    <Meshtastic locale={locale} />
    <Faq locale={locale} />
    <CtaBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
