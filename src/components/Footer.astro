---
import { useTranslations, localePath, type Locale } from '../i18n';
import { withUtm } from '../lib/utm';

interface Props {
  locale: Locale;
  /** The UTM campaign for links that leave the site from this page. */
  campaign?: string;
}
const { locale, campaign = 'home' } = Astro.props;
const home = localePath(locale);
const t = useTranslations(locale);
const year = new Date().getFullYear();

/*
 * REQ-UBI-07: no team names, no team photographs, no university mark. The
 * project code is the institution's own identifier for the work rather than
 * personal information, so it stays.
 */
const links = [
  {
    href: withUtm('https://github.com/TrekLink-Team', { campaign, content: 'footer-repo' }),
    label: t('footer.repo'),
  },
  {
    href: withUtm('https://github.com/TrekLink-Team/treklink-docs', { campaign, content: 'footer-docs' }),
    label: t('footer.docs'),
  },
];
const legal = [
  { href: `${home}privacy/`, label: t('footer.privacy') },
  { href: `${home}terms/`, label: t('footer.terms') },
];
---

<footer class="site-footer" aria-label={t('footer.heading')}>
  <div class="shell inner">
    <div class="brand">
      <img
        class="lockup"
        src="/images/brand/treklink-logo.webp"
        alt="TrekLink"
        width="384"
        height="220"
        loading="lazy"
        decoding="async"
      />
      <p class="tagline">{t('footer.tagline')}</p>
    </div>

    <div class="cols">
      <nav class="links" aria-label={t('footer.heading')}>
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href} rel="noopener noreferrer">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav class="links" aria-label={t('footer.legal')}>
        <ul>
          {
            legal.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="shell rule">
    <p class="rights">&copy; {year} {t('footer.rights')}</p>
    <a class="top-link" href="#top">{t('top.label')} ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-sunken);
    border-top: 1px solid var(--surface-ridge);
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem) 1.5rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: start;
  }

  .lockup {
    height: 3.4rem;
    width: auto;
  }

  .tagline {
    margin-top: 0.7rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
    max-width: 34ch;
  }

  .links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .links a {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
    border-bottom: 1px solid transparent;
  }
  .links a:hover {
    color: var(--moss);
    border-bottom-color: var(--moss-deep);
  }

  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
  }
  .rule {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 2.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--surface-ridge);
  }
  .top-link {
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
  }
  .top-link:hover {
    color: var(--brass);
  }
  .rights {
    color: var(--ink-faint);
    font-size: var(--step--1);
  }
</style>
