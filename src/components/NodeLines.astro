---
import { useTranslations, type Locale, type TranslationKey } from '../i18n';
import { media, type MediaKey } from '../lib/media';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * Four iterations. v1 is the retired perfboard prototype: shown for the
 * story of how the node improved, labelled so nobody mistakes it for a
 * current option. Every spec below comes from the firmware variant configs.
 */
const nodes = ['v1', 'v2', 'v3', 'v4'] as const;
const k = (v: string, f: string) => `node.${v}.${f}` as TranslationKey;
const cards = nodes.map((v) => ({
  id: v,
  retired: v === 'v1',
  flagship: v === 'v4',
  name: t(k(v, 'name')),
  tag: t(k(v, 'tag')),
  hook: t(k(v, 'hook')),
  body: t(k(v, 'body')),
  alt: t(k(v, 'alt')),
  image: media[`node-${v}` as MediaKey],
  specs: [
    { k: t('nodes.spec.board'), v: t(k(v, 'board')) },
    { k: t('nodes.spec.sos'), v: t(k(v, 'sos')) },
    { k: t('nodes.spec.fall'), v: t(k(v, 'fall')), no: v === 'v3' },
  ],
}));
const boardPoints = [t('board.a'), t('board.b'), t('board.c')];
---

<section class="section nodes" id="nodes" aria-labelledby="nodes-heading">
  <div class="shell">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{t('nodes.eyebrow')}</p>
      <h2 id="nodes-heading">{t('nodes.heading')}</h2>
      <p class="lede">{t('nodes.lede')}</p>
    </header>

    {/*
      Below 1100px: a deck of full-width cards. It is a scroll-snap track, so
      without JavaScript it already swipes both ways by touch, trackpad and
      keyboard (REQ-ERR-05). Where scroll-driven animations exist, cards tilt
      and tuck behind the one in view as they are swiped, like cards dealt from
      a hand. The island adds the side arrows, the page dots, arrow keys and
      the live announcement. From 1100px all four sit in one row.
    */}
    <div
      class="carousel"
      data-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label={t('nodes.carousel.label')}
    >
      <div class="stage">
        <div class="track" data-carousel-track tabindex="0">
          {
            cards.map((card, i) => (
              <article
                class:list={['node-card', 'glass', { retired: card.retired, flagship: card.flagship }]}
                data-carousel-item
                style={`--i:${i}`}
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} / ${cards.length}: ${t('nodes.word')} ${card.name}`}
              >
                <div class="node-media">
                  <span class="node-tag">{card.tag}</span>
                  <img
                    src={card.image.src}
                    alt={card.alt}
                    width={card.image.width}
                    height={card.image.height}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                </div>
                <div class="node-info">
                  <div class="node-text">
                    <h3>
                      <span class="node-word">{t('nodes.word')}</span> {card.name}
                    </h3>
                    <p class="node-hook">{card.hook}</p>
                    <p class="node-body">{card.body}</p>
                  </div>
                  <dl class="specs">
                    {card.specs.map((s) => (
                      <div class="spec">
                        <dt>{s.k}</dt>
                        <dd class:list={[{ no: s.no }]}>{s.v}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </article>
            ))
          }
        </div>

        <button type="button" class="ctl ctl-prev" data-carousel-prev data-carousel-controls hidden aria-label={t('nodes.prev')}>
          <svg viewBox="0 0 20 20" width="22" height="22" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" /></svg>
        </button>
        <button type="button" class="ctl ctl-next" data-carousel-next data-carousel-controls hidden aria-label={t('nodes.next')}>
          <svg viewBox="0 0 20 20" width="22" height="22" aria-hidden="true"><path d="m7.5 4 6 6-6 6" /></svg>
        </button>
      </div>

      <div class="dots" data-carousel-controls hidden>
        {
          cards.map((card, i) => (
            <button
              type="button"
              class="dot"
              data-carousel-goto={i}
              aria-label={`${i + 1} / ${cards.length}: ${t('nodes.word')} ${card.name}`}
            >
              <span />
            </button>
          ))
        }
      </div>

      {/* REQ-EVT-07: the change is announced, not only shown. */}
      <p class="sr-only" role="status" aria-live="polite" data-carousel-status></p>
    </div>

    <div class="board glass" data-reveal>
      <div class="board-media">
        <img
          src={media['pcb-v2'].src}
          alt={t('board.alt')}
          width={media['pcb-v2'].width}
          height={media['pcb-v2'].height}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="board-copy">
        <p class="eyebrow">{t('board.eyebrow')}</p>
        <h3>{t('board.heading')}</h3>
        <ul>
          {boardPoints.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .carousel {
    margin-top: clamp(2rem, 1.4rem + 2.6vw, 3.4rem);
  }
  .stage {
    position: relative;
  }

  /* One card per page. No gap between pages: the space sits inside each
     page so a card's tilt never reveals the next card's edge at rest. */
  .track {
    position: relative;
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-block: 0.5rem 1rem;
    touch-action: pan-x pan-y;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline-offset: -2px;
  }

  .node-card {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    display: grid;
    gap: 1rem;
    padding: 0.75rem 0.75rem 0.5rem;
    transition: border-color var(--dur) var(--ease);
  }
  .node-card.flagship {
    border-color: var(--brass);
    box-shadow: var(--shadow-glass), 0 0 0 1px var(--brass-tint-strong), 0 1.5rem 4rem -1rem var(--brass-glow);
  }

  /* The deal: as a card leaves the centre it tilts, shrinks and tucks toward
     the middle, so the next one appears to come off the top of the deck. */
  @media (prefers-reduced-motion: no-preference) and (max-width: 1099px) {
    @supports (animation-timeline: view(inline)) {
      .node-card {
        animation: deal linear both;
        animation-timeline: view(inline);
        animation-range: cover 0% cover 100%;
      }
    }
  }
  @keyframes deal {
    0% {
      transform: translateX(-38%) rotate(7deg) scale(0.84);
      z-index: 0;
    }
    50% {
      transform: none;
      z-index: 2;
    }
    100% {
      transform: translateX(38%) rotate(-7deg) scale(0.84);
      z-index: 0;
    }
  }

  .node-info {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .node-media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: calc(var(--radius-lg) - 3px);
    background:
      radial-gradient(70% 70% at 60% 45%, var(--brass-tint-strong), transparent 70%),
      var(--surface-raised);
    box-shadow: var(--shadow-neo);
    overflow: hidden;
  }
  .node-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--dur-spring) var(--spring);
  }
  .node-card:hover .node-media img {
    transform: scale(1.04) rotate(-1deg);
  }
  .node-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 1;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moss-lit);
    background: var(--surface-base);
    border: 1px solid var(--moss-line);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  .flagship .node-tag {
    color: var(--ink-inverse);
    background: var(--brass);
    border-color: var(--brass);
  }
  /* Retired: still shown, clearly out of the line-up. Dashed edge, a hatched
     tag and a desaturated photo; the text keeps full contrast. */
  .retired {
    border-style: dashed;
  }
  .retired .node-tag {
    color: var(--ink-muted);
    border-color: var(--ink-faint);
    border-style: dashed;
  }
  .retired .node-media img {
    filter: grayscale(0.7);
  }
  .node-word {
    color: var(--ink-faint);
    font-size: 0.6em;
    letter-spacing: 0.1em;
    vertical-align: 0.25em;
  }

  .node-text {
    display: grid;
    gap: 0.4rem;
    padding-inline: 0.35rem;
  }
  .node-text h3 {
    font-size: var(--step-2);
  }
  .node-hook {
    font-weight: 700;
    color: var(--moss-lit);
    line-height: 1.4;
  }
  .node-body {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .specs {
    margin: 0;
    padding: 0.25rem 0.35rem;
    border-top: 1px solid var(--glass-edge);
    align-self: end;
  }
  .spec {
    display: grid;
    grid-template-columns: minmax(5.5rem, 38%) minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--ink-tint);
  }
  .spec:last-child {
    border-bottom: 0;
  }
  .spec dt {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: 0.12rem;
  }
  .spec dd.no {
    color: var(--ink-muted);
    font-weight: 500;
  }
  .spec dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  /* Arrows sit on the card's sides, over the photo band. */
  .ctl {
    position: absolute;
    top: calc(0.5rem + 0.75rem + (min(100vw, 1099px) - 2 * var(--gutter) - 1.5rem) * 0.375);
    z-index: 5;
    width: 2.9rem;
    height: 2.9rem;
    display: grid;
    place-items: center;
    color: var(--ink);
    background: var(--glass-dense);
    border: 1px solid var(--glass-edge);
    border-top-color: var(--glass-edge-lit);
    border-radius: var(--radius);
    box-shadow: var(--shadow-glass);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      transform var(--dur-spring) var(--spring),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }
  .ctl[hidden] {
    display: none;
  }
  .ctl-prev {
    left: 0.25rem;
  }
  .ctl-next {
    right: 0.25rem;
  }
  .ctl svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ctl:hover:not(:disabled) {
    color: var(--brass);
    border-color: var(--brass);
  }
  .ctl:active:not(:disabled) {
    transform: translateY(-50%) scale(0.9);
  }
  .ctl:disabled {
    opacity: 0;
    pointer-events: none;
  }

  /* Page dots, like a phone home screen. 44px targets around small marks. */
  .dots {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-top: 0.1rem;
  }
  .dots[hidden] {
    display: none;
  }
  .dot {
    width: 2.25rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .dot span {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ink-faint);
    transition:
      transform var(--dur-spring) var(--spring),
      background-color var(--dur) var(--ease);
  }
  .dot:hover span {
    background: var(--ink-muted);
  }
  .dot[aria-current='true'] span {
    background: var(--brass);
    transform: scale(1.45);
  }

  .board {
    margin-top: clamp(2rem, 1.4rem + 2.6vw, 3.2rem);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding: clamp(1rem, 0.6rem + 2vw, 2rem);
    overflow: hidden;
  }
  .board-media img {
    width: 100%;
    filter: drop-shadow(0 1.5rem 2rem var(--shade));
    transition: transform var(--dur-spring) var(--spring);
  }
  .board:hover .board-media img {
    transform: rotate(-2deg) scale(1.03);
  }
  .board-copy {
    display: grid;
    gap: 0.9rem;
  }
  .board-copy h3 {
    font-size: var(--step-3);
  }
  .board-copy ul {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .board-copy li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: baseline;
    color: var(--ink);
    font-weight: 600;
  }
  .board-copy li::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    background: var(--moss);
    transform: rotate(45deg) translateY(-0.1rem);
  }
  @media (max-width: 759px) {
    .board {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Tablet: still one card per page, laid out side by side inside it. */
  @media (min-width: 640px) and (max-width: 1099px) {
    .node-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      padding: 1rem;
      gap: 1.5rem;
    }
    .ctl {
      top: 50%;
    }
  }

  /* All four fit: one row from 1100px, no paging, no deck. */
  @media (min-width: 1100px) {
    .ctl,
    .dots {
      display: none;
    }
    .track {
      overflow: visible;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      padding: 0;
    }
    .node-card {
      grid-template-rows: auto 1fr;
      transition:
        transform var(--dur-spring) var(--spring),
        border-color var(--dur) var(--ease);
    }
    .node-card:hover {
      transform: translateY(-4px);
      border-color: var(--glass-edge-lit);
    }
    .node-info {
      grid-template-rows: auto 1fr;
    }
    .specs {
      align-self: end;
    }
  }
</style>
