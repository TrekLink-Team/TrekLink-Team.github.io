---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * One node, three versions. Every board, SOS mechanism and uplink fact below
 * is cited in treklink-docs/_docs/00-project-context/04-firmware-ground-truth.md
 * section 5 and its platformio.ini references. v1 is deliberately absent: D-005
 * puts it out of the demo set, and its MQTT is compiled out at build time.
 */
const nodes = ['v2', 'v3', 'v4'] as const;
const cards = nodes.map((v) => ({
  id: v,
  name: t(`node.${v}.name` as 'node.v2.name'),
  body: t(`node.${v}.body` as 'node.v2.body'),
  alt: t(`node.${v}.alt` as 'node.v2.alt'),
  image: `/images/placeholders/node-${v}.svg`,
  specs: [
    { k: t('nodes.spec.board'), v: t(`node.${v}.board` as 'node.v2.board') },
    { k: t('nodes.spec.sos'), v: t(`node.${v}.sos` as 'node.v2.sos') },
    { k: t('nodes.spec.uplink'), v: t(`node.${v}.uplink` as 'node.v2.uplink') },
  ],
}));
---

<section class="section" id="nodes">
  <div class="shell">
    <header class="section-head">
      <p class="eyebrow">{t('nodes.eyebrow')}</p>
      <h2>{t('nodes.heading')}</h2>
      <p class="lede">{t('nodes.lede')}</p>
    </header>

    {/*
      A scroll-snapped track, not a transform-driven slider. Without
      JavaScript it is a horizontally scrollable list that works by touch,
      trackpad and keyboard already (REQ-ERR-05). The island adds the buttons,
      the live region and the arrow keys on top of behaviour that exists.
    */}
    <div
      class="carousel"
      data-carousel
      role="group"
      aria-roledescription="carousel"
      aria-label={t('nodes.carousel.label')}
    >
      <ul class="track" data-carousel-track tabindex="0">
        {
          cards.map((card, i) => (
            <li
              class="card glass"
              data-carousel-item
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} / ${cards.length}: ${card.name}`}
            >
              <div class="card-media plate">
                <img
                  src={card.image}
                  alt={card.alt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3>{card.name}</h3>
              <p class="card-body">{card.body}</p>
              <dl class="specs">
                {card.specs.map((s) => (
                  <div class="spec">
                    <dt>{s.k}</dt>
                    <dd>{s.v}</dd>
                  </div>
                ))}
              </dl>
            </li>
          ))
        }
      </ul>

      <div class="controls" data-carousel-controls hidden>
        <button type="button" data-carousel-prev aria-label={t('nodes.prev')}>
          <span aria-hidden="true">&#8592;</span>
        </button>
        <span class="dots" data-carousel-dots aria-hidden="true"></span>
        <button type="button" data-carousel-next aria-label={t('nodes.next')}>
          <span aria-hidden="true">&#8594;</span>
        </button>
      </div>

      {/* REQ-EVT-07: the change is announced, not only shown. */}
      <p class="sr-only" role="status" aria-live="polite" data-carousel-status></p>
    </div>
  </div>
</section>

<style>
  .section-head {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }
  h2 {
    font-size: var(--step-3);
  }

  .carousel {
    margin-top: clamp(2.2rem, 1.6rem + 2.6vw, 3.4rem);
  }

  .track {
    list-style: none;
    margin: 0;
    padding: 0.25rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--surface-ridge) transparent;
  }
  .track:focus-visible {
    outline-offset: 0;
  }

  .card {
    scroll-snap-align: center;
    padding: 1rem;
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .card-media {
    padding: 0.45rem;
  }
  .card-media img {
    width: 100%;
    border-radius: calc(var(--radius-lg) - 3px);
  }

  .card h3 {
    font-size: var(--step-2);
    color: var(--ink);
    padding-inline: 0.4rem;
  }
  .card-body {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.6;
    padding-inline: 0.4rem;
  }

  .specs {
    margin: 0.2rem 0 0;
    padding: 0.4rem;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--glass-edge);
  }
  .spec {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.8rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
  }
  .spec:last-child {
    border-bottom: 0;
  }
  .spec dt {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .spec dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink);
    font-weight: 600;
  }

  .controls {
    margin-top: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .controls button {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    font-size: 1.1rem;
    color: var(--ink);
    background: var(--surface-raised);
    border: 1px solid var(--surface-ridge);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .controls button:hover:not(:disabled) {
    color: var(--brass-lit);
    border-color: var(--brass-deep);
  }
  .controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .dots {
    display: inline-flex;
    gap: 0.4rem;
  }
  .dots i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--surface-ridge);
    transition: background-color var(--dur) var(--ease);
  }
  .dots i[data-active] {
    background: var(--brass);
  }

  /* Below the breakpoint the track is one card wide and swipes, which is what
     a touch visitor expects without being told. */
  @media (max-width: 899px) {
    .track {
      grid-auto-columns: minmax(0, 82%);
      padding-inline: 0.25rem;
    }
  }
</style>
