---
import { useTranslations, type Locale, type TranslationKey } from '../i18n';
import { W, H, buildMesh, buildMap, hops } from '../lib/meshmap';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const steps = (['a', 'b', 'c'] as const).map((k, i) => ({
  n: String(i + 1).padStart(2, '0'),
  title: t(`how.${k}.title` as TranslationKey),
  body: t(`how.${k}.body` as TranslationKey),
}));

const { nodes, edges } = buildMesh();
const map = buildMap();

/*
 * Without JavaScript the wave always starts at the left-most trekker. The
 * mesh-map island picks a new origin for every wave. Each element carries its
 * hop count as --hop, so CSS alone times the ripple.
 */
const origin = nodes
  .filter((n) => n.kind === 'trekker')
  .reduce((a, b) => (b.x < a.x ? b : a)).id;
const hop = hops(nodes.length, edges, origin);
const maxHop = Math.max(...hop);
const station = nodes.find((n) => n.kind === 'station')!;
const guide = nodes.find((n) => n.kind === 'guide')!;
const o = nodes[origin]!;

/* Each edge is drawn from its nearer end to its farther end, so the dash
   travels outward from the origin. */
const edgeView = edges.map((e) => {
  const [from, to] = hop[e.a]! <= hop[e.b]! ? [e.a, e.b] : [e.b, e.a];
  return { from, to, hop: hop[from]!, same: hop[from] === hop[to] };
});
/* The island reads the graph as data, never by parsing the markup back. */
const adjacency = JSON.stringify(edges.map((e) => [e.a, e.b]));
const positions = JSON.stringify(nodes.map((n) => [n.x, n.y]));
---

<section class="section how grain" id="how" aria-labelledby="how-heading">
  <div class="glow glow-moss how-glow" aria-hidden="true"></div>
  <div class="shell above">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{t('how.eyebrow')}</p>
      <h2 id="how-heading">{t('how.heading')}</h2>
    </header>

    <figure class="route glass" data-reveal>
      <span class="chip route-proof"><b>{t('proof.towers.value')}</b> {t('how.proof')}</span>
      <svg
        class="mesh run"
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={t('how.diagram.label')}
        preserveAspectRatio="xMidYMid meet"
        data-mesh
        data-loop
        data-edges={adjacency}
        data-pos={positions}
        data-origin={origin}
        style={`--max-hop:${maxHop}`}
      >
        {/* Terrain, generated at build time from a fixed seed. */}
        <g class="map" aria-hidden="true">
          <rect class="map-ground" x="-100" y="-100" width={W + 200} height={H + 200}></rect>
          <g class="map-drift">
            {map.contours.map((d) => <path class="map-contour" d={d} />)}
            <path class="map-water" d={map.lakePath} />
            <path class="map-river-bank" d={map.riverPath} />
            <path class="map-river" d={map.riverPath} />
            <path class="map-river-flow" d={map.riverPath} />
            {map.minor.map((d) => <path class="map-road" d={d} />)}
            {map.major.map((d) => <path class="map-road-major" d={d} />)}
            {map.blocks.map((b) => <rect class="map-block" x={b.x} y={b.y} width={b.w} height={b.h} />)}
          </g>
        </g>

        {/* The droplet: rings that spread from the origin across the map. */}
        <g class="droplet" data-droplet style={`transform: translate(${o.x}px, ${o.y}px)`}>
          <circle r="60" style="--k:0" data-droplet-ring></circle>
          <circle r="60" style="--k:1"></circle>
          <circle r="60" style="--k:2"></circle>
        </g>

        <g class="links">
          {
            edgeView.map((e) => (
              <g class:list={['link', { same: e.same }]} style={`--hop:${e.hop}`} data-a={e.from} data-b={e.to}>
                <line class="link-base" x1={nodes[e.from]!.x} y1={nodes[e.from]!.y} x2={nodes[e.to]!.x} y2={nodes[e.to]!.y} />
                <line class="link-pulse" pathLength="1" x1={nodes[e.from]!.x} y1={nodes[e.from]!.y} x2={nodes[e.to]!.x} y2={nodes[e.to]!.y} />
              </g>
            ))
          }
        </g>

        <g class="nodes">
          {
            nodes.map((n) => (
              <g
                class:list={['node', `node-${n.kind}`, { origin: n.id === origin }]}
                style={`--hop:${hop[n.id]}; transform: translate(${n.x}px, ${n.y}px)`}
                data-node={n.id}
              >
                <circle class="node-ring" r="14" />
                {n.kind === 'station' ? (
                  <>
                    <rect class="node-core" x="-13" y="-13" width="26" height="26" rx="3" />
                    <path class="station-mast" d="M0 -6v12M-5 -1l5-5 5 5" />
                  </>
                ) : n.kind === 'guide' ? (
                  <>
                    <circle class="node-halo" r="15" />
                    <circle class="node-core" r="9" />
                  </>
                ) : (
                  <circle class="node-core" r="8" />
                )}
              </g>
            ))
          }
        </g>

        <g class="labels" aria-hidden="true">
          <text x={guide.x} y={guide.y + 40} text-anchor="middle">{t('how.legend.guide')}</text>
          <text x={station.x - 22} y={station.y + 44} text-anchor="end">{t('how.legend.station')}</text>
        </g>
      </svg>

      <figcaption class="legend">
        <span><i class="key key-origin" aria-hidden="true"></i>{t('how.legend.origin')}</span>
        <span><i class="key key-trekker" aria-hidden="true"></i>{t('how.legend.trekker')}</span>
        <span><i class="key key-guide" aria-hidden="true"></i>{t('how.legend.guide')}</span>
        <span><i class="key key-station" aria-hidden="true"></i>{t('how.legend.station')}</span>
      </figcaption>
    </figure>

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step" data-reveal style={`--i:${i}`}>
            <span class="step-n" aria-hidden="true">
              {s.n}
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    position: relative;
    overflow: clip;
  }
  .how-glow {
    width: 60rem;
    height: 40rem;
    right: -20rem;
    top: 10%;
  }

  .route {
    margin: clamp(2rem, 1.4rem + 2.6vw, 3.2rem) 0 0;
    padding: 0;
    position: relative;
    overflow: hidden;
  }
  .route-proof {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    z-index: 2;
    background: var(--glass-dense);
  }

  .mesh {
    display: block;
    width: 100%;
    aspect-ratio: 1000 / 560;
    height: auto;
    --step: 0.38s;
    --cycle: 6s;
  }

  /* --- Map layer ------------------------------------------------------- */
  .map-ground {
    fill: var(--map-ground);
  }
  .map-contour {
    fill: none;
    stroke: var(--map-contour);
    stroke-width: 1.2;
  }
  .map-water {
    fill: var(--map-water);
    stroke: var(--map-water-edge);
    stroke-width: 1.5;
  }
  .map-river-bank {
    fill: none;
    stroke: var(--map-water-edge);
    stroke-width: 20;
    stroke-linecap: round;
  }
  .map-river {
    fill: none;
    stroke: var(--map-water);
    stroke-width: 17;
    stroke-linecap: round;
  }
  .map-river-flow {
    fill: none;
    stroke: var(--map-water-edge);
    stroke-width: 1.5;
    stroke-dasharray: 3 14;
  }
  .map-road {
    fill: none;
    stroke: var(--map-road);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 7 6;
  }
  .map-road-major {
    fill: none;
    stroke: var(--map-road-major);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .map-block {
    fill: var(--map-block);
    stroke: var(--map-road);
    stroke-width: 1;
  }

  /* --- Mesh ------------------------------------------------------------ */
  .link-base {
    stroke: var(--mesh-edge);
    stroke-width: 1.6;
  }
  .link-pulse {
    stroke: var(--brass-lit);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }
  .node {
    transform-box: view-box;
  }
  .node-core {
    fill: var(--moss);
    stroke: var(--map-ground);
    stroke-width: 3;
    transform-box: fill-box;
    transform-origin: center;
  }
  .node-ring {
    fill: none;
    stroke: var(--brass-lit);
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .node-guide .node-core {
    fill: var(--brass);
  }
  .node-guide .node-halo {
    fill: none;
    stroke: var(--brass);
    stroke-width: 2.5;
  }
  .node-station .node-core {
    fill: var(--surface-raised);
    stroke: var(--brass);
    stroke-width: 3;
  }
  .station-mast {
    fill: none;
    stroke: var(--brass);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .origin .node-core {
    fill: var(--brass-lit);
  }
  .droplet circle {
    fill: none;
    stroke: var(--brass);
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .labels text {
    fill: var(--ink);
    font: 700 17px var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    paint-order: stroke;
    stroke: var(--map-ground);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.9rem 1.1rem;
    border-top: 1px solid var(--glass-edge);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .key {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--moss);
  }
  .key-origin {
    background: var(--brass-lit);
    box-shadow: 0 0 0 3px var(--brass-tint-strong);
  }
  .key-guide {
    background: var(--brass);
    box-shadow: 0 0 0 2px var(--surface-base), 0 0 0 4px var(--brass);
  }
  .key-station {
    border-radius: 2px;
    background: var(--surface-raised);
    border: 2px solid var(--brass);
  }

  /*
   * The wave. Every element runs the same cycle, offset by its hop count, so
   * the pulse leaves the origin, crosses each link and lights each node in
   * turn, like a droplet spreading across water. Reduced motion: a still map
   * with the mesh drawn and nothing moving.
   */
  @media (prefers-reduced-motion: no-preference) {
    .mesh.run .node-core {
      animation: node-hit var(--cycle) var(--ease-out) infinite;
      animation-delay: calc(var(--hop) * var(--step) + 0.25s);
    }
    .mesh.run .node-ring {
      animation: node-ring var(--cycle) var(--ease-out) infinite;
      animation-delay: calc(var(--hop) * var(--step) + 0.25s);
    }
    .mesh.run .link-pulse {
      animation: link-run var(--cycle) linear infinite;
      animation-delay: calc(var(--hop) * var(--step) + 0.25s);
    }
    .mesh.run .droplet circle {
      animation: droplet var(--cycle) cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
      animation-delay: calc(var(--k) * 0.5s);
    }
    .map-river-flow {
      animation: river 9s linear infinite;
    }
    .map-drift {
      animation: drift 40s ease-in-out infinite alternate;
    }
  }
  /* Offscreen, the wave pauses. The reveal island marks <html> once it is
     observing looping decorations, so without JavaScript the map still runs.
     Important because every animation rule above uses the shorthand, which
     resets play-state, and some of them outrank this selector. */
  :global(html[data-loops]) .mesh:not([data-running]) *,
  :global(html[data-loops]) .mesh:not([data-running]) {
    animation-play-state: paused !important;
  }

  @keyframes node-hit {
    0% {
      transform: scale(1);
    }
    3% {
      transform: scale(1.7);
      fill: var(--brass-lit);
    }
    14% {
      transform: scale(1);
    }
  }
  @keyframes node-ring {
    0% {
      opacity: 0.9;
      transform: scale(0.8);
    }
    22% {
      opacity: 0;
      transform: scale(3.6);
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes link-run {
    0% {
      opacity: 1;
      stroke-dashoffset: 1;
    }
    6.3% {
      opacity: 1;
      stroke-dashoffset: 0;
    }
    16% {
      opacity: 0;
      stroke-dashoffset: 0;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes droplet {
    0% {
      opacity: 0.8;
      transform: scale(0.1);
    }
    55% {
      opacity: 0;
      transform: scale(14);
    }
    100% {
      opacity: 0;
      transform: scale(14);
    }
  }
  @keyframes river {
    to {
      stroke-dashoffset: -170;
    }
  }
  @keyframes drift {
    to {
      transform: translate(-18px, 10px);
    }
  }

  .steps {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .step {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.2rem 0.2rem 0;
    border-top: 2px solid var(--surface-ridge);
  }
  .step-n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--brass);
  }
  .step h3 {
    font-size: var(--step-2);
  }
  .step p {
    color: var(--ink-muted);
    line-height: 1.6;
  }

  @media (max-width: 799px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Small screens: the map scales down, so the marks scale up. */
  @media (max-width: 639px) {
    .labels {
      display: none;
    }
    .node-core {
      r: 13px;
    }
    .link-base {
      stroke-width: 3;
    }
    .link-pulse {
      stroke-width: 5;
    }
    .route-proof {
      position: static;
      display: flex;
      width: fit-content;
      margin: 0.9rem 1.1rem 0;
    }
  }
</style>
