---
import { siteConfig } from '../../site.config';
import { useTranslations, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localePath(locale);
const other: Locale = locale === 'en' ? 'vi' : 'en';

const sections = [
  { id: 'problem', label: t('nav.problem') },
  { id: 'how', label: t('nav.how') },
  { id: 'nodes', label: t('nav.nodes') },
  { id: 'faq', label: t('nav.faq') },
];
---

<header class="site-header" data-site-header>
  <div class="header-rail">
    <a class="wordmark" href={home}>
      {/* The mark alone. The lockup also carries the word, and setting it
          twice beside itself would say the name twice. */}
      <img
        class="wordmark-mark"
        src="/images/brand/treklink-mark.webp"
        alt=""
        width="312"
        height="120"
        aria-hidden="true"
      />
      <span>TrekLink</span>
    </a>

    {/*
      The capsule. Fyntic's floating pill, in our geometry: a hard 5px radius
      rather than a full round, because the rest of the page reads as field
      equipment and a lozenge would not.
    */}
    <nav class="capsule" aria-label={t('nav.label')}>
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`${home}#${s.id}`} data-spy-link={s.id}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-end">
      {/*
        An anchor first (REQ-EVT-05). Without JavaScript this is a plain link
        to the mirrored route, which is the correct behaviour rather than a
        degraded one. The script only adds persistence.
      */}
      <a
        class="lang"
        href={localePath(other)}
        hreflang={other}
        data-lang-switch={other}
        aria-label={`${t('lang.label')}: ${other === 'vi' ? t('lang.vi') : t('lang.en')}`}
      >
        {other === 'vi' ? 'VI' : 'EN'}
      </a>

      {/*
        Also an anchor first. Without JavaScript it navigates straight to the
        operations system and the browser reports any failure itself, which is
        the right fallback (REQ-ERR-05). The island upgrades it to a checked
        link on activation.
      */}
      <a
        class="btn btn-primary system-link"
        href={siteConfig.operationsUrl}
        data-system-link
        data-label={t('system.link')}
        data-checking={t('system.checking')}
        data-toast-message={t('system.toast')}
        data-toast-dismiss={t('system.unavailable.dismiss')}
      >
        <span data-system-link-text>{t('system.link')}</span>
        <span class="spinner" aria-hidden="true"></span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
        data-open={t('nav.menu.open')}
        data-close={t('nav.menu.close')}
      >
        <span class="sr-only">{t('nav.menu.open')}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  {/* REQ-STA-03: below the breakpoint the navigation is a disclosure. */}
  <div class="mobile-nav glass" id="mobile-nav" hidden>
    <ul>
      {
        sections.map((s) => (
          <li>
            <a href={`${home}#${s.id}`} data-spy-link={s.id} data-mobile-link>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mobile-system">
      <a
        class="btn btn-primary"
        href={siteConfig.operationsUrl}
        data-system-link
        data-label={t('system.link')}
        data-checking={t('system.checking')}
        data-toast-message={t('system.toast')}
        data-toast-dismiss={t('system.unavailable.dismiss')}
      >
        <span data-system-link-text>{t('system.link')}</span>
        <span class="spinner" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</header>

<style>
  /*
   * A floating glass bar. Sticky by default, so it works without JavaScript.
   * The header island adds [data-hidden] while the visitor scrolls down and
   * removes it the moment they scroll up; the move is a transform on the
   * compositor, so it never shifts layout or jitters.
   */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.6rem var(--gutter) 0;
    transition: transform 420ms var(--ease-out);
    will-change: transform;
  }
  .site-header[data-hidden] {
    transform: translateY(calc(-100% - 0.5rem));
  }

  .header-rail {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 0.4rem 0.4rem 0.4rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--glass-edge);
    border-top-color: var(--glass-edge-lit);
    border-radius: var(--radius-lg);
    background: var(--glass-solid);
    box-shadow: var(--shadow-glass);
    transition: background-color var(--dur) var(--ease);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .header-rail {
      background: linear-gradient(155deg, var(--glass-fill-top), var(--glass-fill-bottom)), var(--glass-dense);
      backdrop-filter: blur(16px) saturate(150%);
      -webkit-backdrop-filter: blur(16px) saturate(150%);
    }
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  /* The waves beside the peaks smear below roughly 40px of mark height. */
  .wordmark-mark {
    height: 2.1rem;
    width: auto;
    flex: none;
  }

  .capsule {
    margin-inline: auto;
  }
  .capsule ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .capsule a {
    position: relative;
    display: block;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .capsule a::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.35rem;
    height: 2px;
    background: var(--brass);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-spring) var(--spring);
  }
  .capsule a:hover {
    color: var(--ink);
  }
  .capsule a[aria-current='true'] {
    color: var(--brass-lit);
  }
  .capsule a[aria-current='true']::after,
  .capsule a:hover::after {
    transform: scaleX(1);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    text-decoration: none;
    border: 1px solid var(--surface-ridge);
    border-radius: var(--radius-sm);
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .lang:hover {
    color: var(--moss);
    border-color: var(--moss);
  }

  .system-link {
    position: relative;
    min-height: 2.75rem;
    padding-block: 0.6rem;
    box-shadow: 0 4px 0 var(--brass-deep);
  }
  .system-link[data-state='checking'] {
    pointer-events: none;
  }
  .spinner {
    display: none;
    width: 0.85em;
    height: 0.85em;
    border: 2px solid var(--shade);
    border-top-color: var(--ink-inverse);
    border-radius: 50%;
    animation: spin 700ms linear infinite;
  }
  .system-link[data-state='checking'] .spinner {
    display: inline-block;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    background: transparent;
    border: 1px solid var(--surface-ridge);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .bars i {
    display: block;
    height: 2px;
    background: var(--ink);
    transition: transform var(--dur-spring) var(--spring);
  }
  .menu-toggle[aria-expanded='true'] .bars i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bars i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-nav {
    max-width: var(--shell);
    margin: 0.4rem auto 0;
    border-radius: var(--radius-lg);
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
  }
  .mobile-nav a {
    display: block;
    padding: 0.9rem;
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .mobile-nav a:hover,
  .mobile-nav a[aria-current='true'] {
    color: var(--brass-lit);
    background: var(--brass-tint);
  }

  .mobile-system {
    padding: 0.2rem 0.4rem 0.6rem;
  }
  .mobile-system .btn {
    width: 100%;
  }
  .mobile-system [data-state='checking'] .spinner {
    display: inline-block;
  }

  @media (max-width: 959px) {
    .capsule {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
  @media (max-width: 599px) {
    .system-link {
      display: none;
    }
  }
  @media (max-width: 339px) {
    .wordmark span:last-child {
      display: none;
    }
  }
</style>
