---
import { siteConfig } from '../../site.config';
import { useTranslations, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localePath(locale);
const other: Locale = locale === 'en' ? 'vi' : 'en';

const sections = [
  { id: 'problem', label: t('nav.problem') },
  { id: 'nodes', label: t('nav.nodes') },
  { id: 'research', label: t('nav.research') },
];
---

<header class="site-header">
  <div class="header-rail">
    <a class="wordmark" href={home}>
      {/* The mark alone. The lockup also carries the word, and setting it
          twice beside itself would say the name twice. */}
      <img
        class="wordmark-mark"
        src="/images/brand/treklink-mark.webp"
        alt=""
        width="312"
        height="120"
        aria-hidden="true"
      />
      <span>TrekLink</span>
    </a>

    {/*
      The capsule. Fyntic's floating pill, in our geometry: a hard 5px radius
      rather than a full round, because the rest of the page reads as field
      equipment and a lozenge would not.
    */}
    <nav class="capsule glass" aria-label={t('nav.label')}>
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`${home}#${s.id}`} data-spy-link={s.id}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-end">
      {/*
        An anchor first (REQ-EVT-05). Without JavaScript this is a plain link
        to the mirrored route, which is the correct behaviour rather than a
        degraded one. The script only adds persistence.
      */}
      <a
        class="lang"
        href={localePath(other)}
        hreflang={other}
        data-lang-switch={other}
        aria-label={`${t('lang.label')}: ${other === 'vi' ? t('lang.vi') : t('lang.en')}`}
      >
        {other === 'vi' ? 'VI' : 'EN'}
      </a>

      {/*
        Also an anchor first. Without JavaScript it navigates straight to the
        operations system and the browser reports any failure itself, which is
        the right fallback (REQ-ERR-05). The island upgrades it to a checked
        link on activation.
      */}
      <a
        class="btn btn-primary system-link"
        href={siteConfig.operationsUrl}
        data-system-link
        data-label={t('system.link')}
        data-checking={t('system.checking')}
        data-toast-title={t('system.unavailable.title')}
        data-toast-body={t('system.unavailable.body')}
        data-toast-dismiss={t('system.unavailable.dismiss')}
      >
        <span data-system-link-text>{t('system.link')}</span>
        <span class="spinner" aria-hidden="true"></span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
        data-open={t('nav.menu.open')}
        data-close={t('nav.menu.close')}
      >
        <span class="sr-only">{t('nav.menu.open')}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  {/* REQ-STA-03: below the breakpoint the navigation is a disclosure. */}
  <div class="mobile-nav glass" id="mobile-nav" hidden>
    <ul>
      {
        sections.map((s) => (
          <li>
            <a href={`${home}#${s.id}`} data-spy-link={s.id} data-mobile-link>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--surface-base) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--surface-ridge);
  }

  .header-rail {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 0.7rem var(--gutter);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  /*
   * 2.1rem rather than matching the cap height of the wordmark beside it. The
   * mark carries signal waves flanking the peaks, and below roughly 40px those
   * waves collapse into a smear. There is no clean vertical gap to crop them
   * away at, because they overlap the peaks horizontally, so the answer is to
   * give the whole mark the room it needs.
   */
  .wordmark-mark {
    height: 2.1rem;
    width: auto;
    flex: none;
  }

  .capsule {
    margin-inline: auto;
    padding: 0.3rem;
    border-radius: var(--radius);
  }
  .capsule ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .capsule a {
    display: block;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .capsule a:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 5%);
  }
  /* Set by the scrollspy island. Never scrolls; only marks (REQ-EVT-06). */
  .capsule a[aria-current='true'] {
    color: var(--brass-lit);
    background: rgb(192 138 62 / 13%);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .lang {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 0.55rem 0.6rem;
    border: 1px solid var(--surface-ridge);
    border-radius: var(--radius-sm);
  }
  .lang:hover {
    color: var(--moss);
    border-color: var(--moss-deep);
  }

  .system-link {
    position: relative;
    padding-block: 0.7rem;
  }
  .system-link[data-state='checking'] {
    pointer-events: none;
  }

  .spinner {
    display: none;
    width: 0.85em;
    height: 0.85em;
    border: 2px solid rgb(0 0 0 / 30%);
    border-top-color: var(--ink-inverse);
    border-radius: 50%;
    animation: spin 700ms linear infinite;
  }
  .system-link[data-state='checking'] .spinner {
    display: inline-block;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--surface-ridge);
    border-radius: var(--radius-sm);
    padding: 0.6rem;
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 4px;
    width: 18px;
  }
  .bars i {
    display: block;
    height: 2px;
    background: var(--ink);
    transition: transform var(--dur) var(--ease);
  }
  .menu-toggle[aria-expanded='true'] .bars i:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bars i:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .mobile-nav {
    margin: 0 var(--gutter) 0.7rem;
    border-radius: var(--radius);
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
  }
  .mobile-nav a {
    display: block;
    padding: 0.8rem 0.9rem;
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .mobile-nav a:hover,
  .mobile-nav a[aria-current='true'] {
    color: var(--brass-lit);
    background: rgb(192 138 62 / 13%);
  }

  @media (max-width: 899px) {
    .capsule {
      display: none;
    }
    .menu-toggle {
      display: block;
    }
  }

  @media (max-width: 559px) {
    .system-link {
      padding-inline: 0.9rem;
    }
    .wordmark span:last-child {
      display: none;
    }
  }
</style>
