---
import { useTranslations, type Locale, type TranslationKey } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/* Three rows, each a before and after of the same moment on the route. */
const rows = (['a', 'b', 'c'] as const).map((k) => ({
  without: t(`problem.${k}.without` as TranslationKey),
  with: t(`problem.${k}.with` as TranslationKey),
}));
---

<section class="section problem" id="problem" aria-labelledby="problem-heading">
  <div class="shell">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{t('problem.eyebrow')}</p>
      <h2 id="problem-heading">{t('problem.heading')}</h2>
    </header>

    <div class="compare" role="table" aria-labelledby="problem-heading">
      <div class="compare-head" role="row">
        <span role="columnheader" class="col-without">{t('problem.without.label')}</span>
        <span role="columnheader" class="col-with">{t('problem.with.label')}</span>
      </div>
      {
        rows.map((r, i) => (
          <div class="compare-row" role="row" data-reveal style={`--i:${i}`}>
            <p role="cell" class="cell-without">
              <span class="mark mark-without" aria-hidden="true" />
              <span class="sr-only">{t('problem.without.label')}: </span>
              {r.without}
            </p>
            <p role="cell" class="cell-with glass">
              <span class="mark mark-with" aria-hidden="true" />
              <span class="sr-only">{t('problem.with.label')}: </span>
              {r.with}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .problem {
    background:
      linear-gradient(to bottom, var(--surface-base), var(--surface-2) 30%, var(--surface-2) 70%, var(--surface-base));
  }

  .compare {
    margin-top: clamp(2rem, 1.4rem + 2.6vw, 3.2rem);
    display: grid;
    gap: 0.75rem;
  }
  .compare-head,
  .compare-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 0.75rem;
    align-items: stretch;
  }
  .compare-head span {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-inline: 1.1rem;
  }
  .col-without {
    color: var(--ink-faint);
  }
  .col-with {
    color: var(--moss);
  }

  .compare-row p {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
    padding: 1.1rem 1.2rem;
    line-height: 1.55;
  }
  .cell-without {
    color: var(--ink-faint);
    border: 1px dashed var(--surface-ridge);
    border-radius: var(--radius-lg);
  }
  .cell-with {
    color: var(--ink);
    font-weight: 600;
    transition:
      transform var(--dur-spring) var(--spring),
      border-color var(--dur) var(--ease);
  }
  .compare-row:hover .cell-with {
    transform: translateX(0.3rem);
    border-color: var(--moss-line);
  }

  /* Shape carries the meaning, so it survives without colour. */
  .mark {
    width: 0.85rem;
    height: 0.85rem;
    margin-top: 0.35rem;
    border-radius: 2px;
  }
  .mark-without {
    border: 2px solid var(--ink-faint);
    background: linear-gradient(
        to bottom right,
        transparent calc(50% - 1px),
        var(--ink-faint) calc(50% - 1px) calc(50% + 1px),
        transparent calc(50% + 1px)
      )
      no-repeat;
  }
  .mark-with {
    background: var(--moss);
    box-shadow: 0 0 0 4px var(--moss-tint-strong);
  }

  @media (max-width: 699px) {
    .compare-head {
      display: none;
    }
    .compare-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
      margin-bottom: 0.6rem;
    }
    .cell-without {
      border: 0;
      padding-block: 0.4rem 0.2rem;
      font-size: var(--step--1);
    }
  }
</style>
