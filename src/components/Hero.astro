---
import { useTranslations, type Locale } from '../i18n';
import { media } from '../lib/media';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const stats = [
  { value: t('stat.versions.value'), label: t('stat.versions.label') },
  { value: t('stat.prealarm.value'), label: t('stat.prealarm.label') },
  { value: t('stat.towers.value'), label: t('stat.towers.label') },
];

/*
 * The capability strip. Every claim here is verifiable against
 * treklink-docs/_docs/00-project-context/04-firmware-ground-truth.md, which is
 * the bar for anything a review panel can read off the page.
 */
const capabilities = [
  'LoRa mesh',
  'GPS position',
  'Fall detection',
  'Device SOS broadcast',
  'Store and forward',
  'Basecamp gateway',
];
---

<section class="hero grain contours" id="product">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="shell above">
    <p class="badge">
      <span class="badge-chip">v4</span>
      <span>{t('hero.eyebrow')}</span>
    </p>

    <h1>
      <span>{t('hero.headline.a')}</span>
      <span class="accent">{t('hero.headline.b')}</span>
    </h1>

    <p class="hero-sub">{t('hero.sub')}</p>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#nodes">{t('hero.cta.primary')}</a>
      <a class="btn btn-ghost" href="#research">{t('hero.cta.secondary')}</a>
    </div>

    <div class="plate hero-plate">
      <img
        src={media.hero.src}
        alt={t('hero.plate.alt')}
        width={media.hero.width}
        height={media.hero.height}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-status glass">
        <span class="hero-status-dot" aria-hidden="true"></span>
        <span class="hero-status-label">{t('hero.status.label')}</span>
        <span class="hero-status-value">{t('hero.status.value')}</span>
      </div>
    </div>

    <ul class="stats">
      {
        stats.map((s, i) => (
          <li class={`glass stat${i === 0 ? ' stat-lead' : ''}`}>
            <span class="stat-tab" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {/*
    Fyntic's marquee, made honest. It is a static wrapping list, not a moving
    one: an infinite horizontal scroll is motion a visitor cannot pause, and
    the content is short enough to simply fit.
  */}
  <ul class="capabilities above">
    {
      capabilities.map((c) => (
        <li>
          <span class="tick" aria-hidden="true">
            &#10003;
          </span>
          {c}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) var(--section-y);
    text-align: center;
  }

  /* One warm source, top centre. The wood grain beneath gives the glass
     panels something to refract, which is the point of having it. */
  .hero-glow {
    position: absolute;
    top: -34rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(120rem, 190%);
    height: 58rem;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgb(192 138 62 / 22%) 0%,
      rgb(143 175 116 / 9%) 38%,
      transparent 68%
    );
    pointer-events: none;
    z-index: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.9rem 0.35rem 0.35rem;
    border: 1px solid var(--glass-edge);
    background: rgb(255 255 255 / 4%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: var(--radius);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }
  .badge-chip {
    background: var(--brass);
    color: var(--ink-inverse);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h1 {
    margin-top: 1.4rem;
    font-size: var(--step-4);
    display: grid;
    gap: 0.05em;
  }
  h1 .accent {
    color: var(--moss);
  }

  .hero-sub {
    margin: 1.4rem auto 0;
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    gap: 1.4rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-plate {
    position: relative;
    margin: clamp(2.5rem, 1.6rem + 4vw, 4.5rem) auto 0;
    max-width: 62rem;
    padding: 0.6rem;
    overflow: visible;
  }
  .hero-plate img {
    width: 100%;
    border-radius: calc(var(--radius-lg) - 2px);
  }

  .hero-status {
    position: absolute;
    left: 50%;
    bottom: -1.4rem;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
    white-space: nowrap;
    font-size: var(--step--1);
  }
  .hero-status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--moss);
    box-shadow: 0 0 0 4px rgb(143 175 116 / 20%);
    flex: none;
  }
  .hero-status-label {
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .hero-status-value {
    color: var(--ink);
    font-weight: 600;
  }

  /* Ridge-tab bento: the lead stat spans the full row at full size, the
     other two share a row at a reduced value size. Same two-column shape
     holds at every width, so mobile gets the compact layout for free
     instead of a separate override. */
  .stats {
    list-style: none;
    margin: clamp(3rem, 2rem + 4vw, 5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
    text-align: left;
  }
  .stat {
    position: relative;
    padding: 1.3rem 1.4rem 1.1rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .stat-lead {
    grid-column: 1 / -1;
  }
  .stat-tab {
    position: absolute;
    top: 0.75rem;
    right: 0.85rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--brass);
    background: rgb(192 138 62 / 14%);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
  }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1;
    color: var(--brass);
  }
  .stat:not(.stat-lead) .stat-value {
    font-size: var(--step-1);
  }
  .stat-label {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .capabilities {
    list-style: none;
    margin: clamp(2.5rem, 1.8rem + 3vw, 4rem) auto 0;
    padding-inline: var(--gutter);
    max-width: var(--shell);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .capabilities li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--surface-ridge);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 2.5%);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-muted);
  }
  .tick {
    color: var(--moss);
    font-weight: 800;
  }

  @media (max-width: 767px) {
    .hero-status {
      position: static;
      transform: none;
      margin-top: 0.6rem;
      justify-content: center;
      white-space: normal;
    }

    /* Spec tape: the chip row scrolls horizontally with a fading edge
       instead of wrapping into a ragged multi-line block. */
    .capabilities {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black 1.2rem,
        black calc(100% - 1.2rem),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black 1.2rem,
        black calc(100% - 1.2rem),
        transparent 100%
      );
    }
    .capabilities li {
      flex: none;
      white-space: nowrap;
    }
  }
</style>
