---
import { useTranslations, type Locale } from '../i18n';
import { media } from '../lib/media';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/* Proof sits beside the headline. Every figure is a firmware fact. */
const proof = [
  { v: t('proof.towers.value'), l: t('proof.towers.label') },
  { v: t('proof.canned.value'), l: t('proof.canned.label') },
  { v: t('proof.band.value'), l: t('proof.band.label') },
];
---

<section class="hero grain contours" id="product" aria-labelledby="hero-heading">
  <div class="glow glow-brass hero-glow-a" aria-hidden="true"></div>
  <div class="glow glow-moss hero-glow-b" aria-hidden="true"></div>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="shell above hero-grid">
    <div class="hero-copy">
      <p class="eyebrow enter" style="--d:0">{t('hero.eyebrow')}</p>

      <h1 id="hero-heading" class="enter" style="--d:1">
        {t('hero.headline.a')}{' '}<span class="accent">{t('hero.headline.b')}</span>{' '}{t('hero.headline.c')}
      </h1>

      <p class="hero-sub enter" style="--d:2">{t('hero.sub')}</p>

      <div class="hero-actions enter" style="--d:3">
        <a class="btn btn-primary" href="#nodes">
          {t('hero.cta.primary')} <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href="#how">{t('hero.cta.secondary')}</a>
      </div>

      <ul class="proof enter" style="--d:4">
        {
          proof.map((p) => (
            <li class="chip">
              <b>{p.v}</b> {p.l}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-visual">
      <div class="hero-float">
        <img
          src={media.lineup.src}
          alt={t('hero.plate.alt')}
          width={media.lineup.width}
          height={media.lineup.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="hero-status glass enter" style="--d:4">
        <p class="status-row">
          <span class="pulse" aria-hidden="true"></span>
          <span class="status-label">{t('hero.status.label')}</span>
        </p>
        <p class="status-value">{t('hero.status.value')}</p>
        <p class="status-note">{t('hero.status.note')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) var(--section-y);
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + clamp(2rem, 1rem + 4vw, 4.5rem));
  }

  .hero-glow-a {
    width: min(70rem, 140vw);
    height: 50rem;
    right: -18rem;
    top: -6rem;
  }
  .hero-glow-b {
    width: 44rem;
    height: 36rem;
    left: -16rem;
    bottom: -14rem;
  }

  .hero-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10rem;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(transparent, var(--surface-base));
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }

  .hero-copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  h1 {
    font-size: clamp(2.5rem, 1.4rem + 4.2vw, 4.9rem);
    line-height: 0.93;
    max-width: 17ch;
  }
  h1 .accent {
    color: var(--moss);
  }

  .hero-sub {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }

  .proof {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-visual {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .hero-float img {
    width: min(112%, 44rem);
    max-width: none;
    margin-inline: -6%;
    filter: drop-shadow(0 2.5rem 2.5rem var(--shade));
  }

  /* Sits under the product, never over it, on dense glass: the text must hold
     4.5:1 whatever the photo behind it does. */
  .hero-status {
    position: relative;
    justify-self: end;
    margin-top: -1.5rem;
    width: min(19rem, 90%);
    background-color: var(--glass-dense);
    padding: 1rem 1.15rem;
    display: grid;
    gap: 0.35rem;
  }
  .status-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .pulse {
    position: relative;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--moss);
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--moss);
    opacity: 0;
  }
  .status-label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--moss-lit);
  }
  .status-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .status-note {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* --- Motion ---------------------------------------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    /* Load entrance, staggered by --d. */
    .enter {
      animation: hero-in 900ms var(--ease-out) both;
      animation-delay: calc(var(--d, 0) * 90ms + 60ms);
    }
    .hero-float {
      animation: float 7s ease-in-out infinite;
    }
    .hero-float img {
      animation: hero-img-in 1200ms var(--ease-out) both 120ms;
    }
    .pulse::after {
      animation: ping 1.9s var(--ease-out) infinite;
    }

    /* Parallax: the product drifts slower than the page as the hero leaves. */
    @supports (animation-timeline: scroll()) {
      .hero-visual {
        animation: hero-parallax linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .hero::after {
        animation: contour-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(1.75rem);
    }
  }
  @keyframes hero-img-in {
    from {
      opacity: 0;
      transform: translateY(3rem) scale(0.94) rotate(2deg);
    }
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.75rem);
    }
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
  @keyframes hero-parallax {
    to {
      transform: translateY(6rem);
    }
  }
  @keyframes contour-drift {
    to {
      transform: translateY(-4rem);
    }
  }

  @media (max-width: 899px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-float img {
      width: min(100%, 30rem);
      margin-inline: 0;
    }
    .hero-status {
      justify-self: center;
      width: min(20rem, 100%);
    }
  }
  @media (max-width: 479px) {
    .hero-actions {
      width: 100%;
      display: grid;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
